{
  "name": "@prestyj/agent",
  "version": "5.33.0",
  "type": "module",
  "description": "Agent loop for LLMs: runs your tools, feeds results back and loops until done, with retries, steering and cancellation. Works with every @prestyj/ai provider.",
  "author": "Nolan Grout",
  "keywords": [
    "llm",
    "ai",
    "agent",
    "agent-loop",
    "tool-calling",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gahroot/ezcoder.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/Gahroot/ezcoder/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/Gahroot/ezcoder/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prestyj/ai": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
