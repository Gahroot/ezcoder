{
  "name": "@prestyj/core",
  "version": "5.33.0",
  "type": "module",
  "description": "Model registry, sign-in and stored credentials, and local model discovery for apps built on @prestyj/ai. No UI, no agent loop.",
  "author": "Nolan Grout",
  "keywords": [
    "llm",
    "ai",
    "model-registry",
    "oauth",
    "ollama",
    "local-models"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gahroot/ezcoder.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Gahroot/ezcoder/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Gahroot/ezcoder/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./models": {
      "types": "./dist/model-registry.d.ts",
      "import": "./dist/model-registry.js",
      "require": "./dist/model-registry.cjs"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prestyj/ai": "workspace:*"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0",
    "ogg-opus-decoder": "^1.7.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
