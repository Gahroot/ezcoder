{
  "name": "ezcoder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter ezcoder-app lint",
    "lint:fix": "eslint 'packages/*/src/**/*.{ts,tsx}' --fix && pnpm --filter ezcoder-app lint:fix",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter ezcoder-app format",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}' && pnpm --filter ezcoder-app format:check",
    "test": "pnpm -r test",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "global-agent": "4.1.3",
      "ip-address": "10.5.0",
      "protobufjs": "7.6.5",
      "tar": "7.5.22",
      "ws": "8.21.3",
      "hono": "4.13.5",
      "fast-uri": "3.1.6",
      "picomatch": "2.3.2",
      "sharp": "0.35.4",
      "@hono/node-server": "1.19.17",
      "qs": "6.15.2",
      "body-parser": "2.3.0"
    },
    "patchedDependencies": {
      "ink@7.0.2": "patches/ink@7.0.2.patch"
    }
  },
  "dependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.60.0"
  }
}
